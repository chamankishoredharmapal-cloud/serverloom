# Copy to .env.local for development. NEVER commit real secrets.
# Postgres connection (Supabase: Project Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:54322/postgres

# Cron/operator gate for archive & carry endpoints (Phase 8 ADR-011)
OPS_SECRET=change-me-in-real-environments

# Supabase Auth (Phase 7 SECURITY §1). When absent the app runs local-mode auth
# against profiles credentials for development only — never production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
